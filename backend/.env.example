
APP_NAME=Advertly
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/advertly_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=advertly_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=please-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
EMAIL_FROM=noreply@example.com
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=postgres
SMTP_PASSWORD=postgres
LOG_LEVEL=DEBUG

# AI/LLM Settings (OpenAI)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_TEXT_MODEL=gpt-6-luna
# Reasoning effort for the text model: none | low | medium | high | xhigh | max (blank = model default)
OPENAI_REASONING_EFFORT=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Image quality: low | medium | high | xhigh | max | auto
OPENAI_IMAGE_QUALITY=medium
# Images generated in parallel per page (OpenAI Tier 1 allows 5 images/minute)
OPENAI_IMAGE_CONCURRENCY=4

